# Copy to .env and fill in. Never commit .env.

# Postgres (local: Homebrew postgresql@17; Railway: ${{Postgres.DATABASE_URL}})
DATABASE_URL=postgresql://postgres@localhost:5432/photosheet

# Public URL of the web service (used for auth callbacks, share links, emails)
APP_URL=http://localhost:3000

# Session/crypto secret, >= 32 chars. Generate with: openssl rand -base64 32
AUTH_SECRET=

# S3-compatible storage (local: MinIO; Railway: Bucket service variables)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=photosheet
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
# true for MinIO, false for Railway Buckets / AWS S3 / R2
S3_FORCE_PATH_STYLE=true

# Email via Resend. Leave RESEND_API_KEY empty in dev to write emails to .mail-outbox/ instead.
RESEND_API_KEY=
EMAIL_FROM="PhotoSheet <no-reply@example.com>"

# Max upload size per file, in MB
MAX_UPLOAD_MB=50
