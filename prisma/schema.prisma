// PhotoSheet schema.
// Auth models (User, Session, Account, Verification, Organization, Member, Invitation, RateLimit)
// follow Better Auth's expected shape — regenerate with `npx auth generate` if plugins change,
// then re-apply the app relations below. App models use snake_case table names.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String       @id
  name          String
  email         String
  emailVerified Boolean      @default(false)
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  sessions      Session[]
  accounts      Account[]
  members       Member[]
  invitations   Invitation[]
  auditEvents   AuditEvent[]
  images        Image[]      @relation("uploader")
  boards        Board[]

  @@unique([email])
  @@map("user")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Organization {
  id          String         @id
  name        String
  slug        String
  logo        String?
  createdAt   DateTime
  metadata    String?
  members     Member[]
  invitations Invitation[]
  auditEvents AuditEvent[]
  images      Image[]
  boards      Board[]
  presets     ResizePreset[]

  @@unique([slug])
  @@map("organization")
}

model Member {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("viewer")
  createdAt      DateTime

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

model RateLimit {
  id          String @id
  key         String
  count       Int
  lastRequest BigInt

  @@unique([key])
  @@map("rateLimit")
}

// ─── App models ────────────────────────────────────────────────────────────────

enum ImageStatus {
  UPLOADING
  PROCESSING
  READY
  FAILED
}

/// An original image. The original object in storage is never modified.
model Image {
  id               String       @id @default(uuid(7))
  orgId            String
  org              Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  uploaderId       String?
  uploader         User?        @relation("uploader", fields: [uploaderId], references: [id], onDelete: SetNull)
  filename         String
  storageKey       String       @unique
  mimeType         String
  bytes            Int
  width            Int?
  height           Int?
  sha256           String?
  /// Selected EXIF fields (camera, lens, exposure, GPS...), see src/lib/image/exif.ts
  exif             Json?
  takenAt          DateTime?
  // Thumbnails (WebP) generated by the worker
  thumbKey         String?
  previewKey       String?
  // Golden-source metadata
  title            String?
  description      String?
  tags             String[]     @default([])
  credit           String?
  copyright        String?
  licence          String?
  licenceExpiresAt DateTime?
  // Lifecycle
  status           ImageStatus  @default(UPLOADING)
  error            String?
  deletedAt        DateTime?
  deletedById      String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  boards           BoardImage[]
  coverOf          Board[]      @relation("cover")
  renditions       Rendition[]

  @@index([orgId, deletedAt, createdAt(sort: Desc), id(sort: Desc)])
  @@index([orgId, sha256])
  @@index([orgId, filename])
  @@index([orgId, takenAt])
  @@index([tags], type: Gin)
  @@map("image")
}

model AuditEvent {
  id         String       @id @default(uuid(7))
  orgId      String
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  targetType String
  targetId   String?
  meta       Json         @default("{}")
  createdAt  DateTime     @default(now())

  @@index([orgId, createdAt(sort: Desc)])
  @@map("audit_event")
}

/// A named collection (contact sheet). Images can belong to many boards.
model Board {
  id           String       @id @default(uuid(7))
  orgId        String
  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  coverImageId String?
  coverImage   Image?       @relation("cover", fields: [coverImageId], references: [id], onDelete: SetNull)
  createdById  String?
  createdBy    User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  images       BoardImage[]

  @@index([orgId, updatedAt(sort: Desc)])
  @@map("board")
}

model BoardImage {
  boardId  String
  board    Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  imageId  String
  image    Image    @relation(fields: [imageId], references: [id], onDelete: Cascade)
  /// 0-based manual order within the board (renumbered on reorder).
  position Int
  addedAt  DateTime @default(now())

  @@id([boardId, imageId])
  @@index([boardId, position])
  @@index([imageId])
  @@map("board_image")
}

enum RenditionStatus {
  PENDING
  READY
  FAILED
}

/// A cached resize/convert of an original, keyed by (image, params).
model Rendition {
  id         String          @id @default(uuid(7))
  imageId    String
  image      Image           @relation(fields: [imageId], references: [id], onDelete: Cascade)
  paramsHash String
  /// Canonical render params (see src/lib/image/render-params.ts)
  params     Json
  format     String
  status     RenditionStatus @default(PENDING)
  storageKey String?
  width      Int?
  height     Int?
  bytes      Int?
  error      String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@unique([imageId, paramsHash])
  @@map("rendition")
}

/// Named export sizes, editable per organisation.
model ResizePreset {
  id            String       @id @default(uuid(7))
  orgId         String
  org           Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name          String
  /// null = keep the original dimension
  width         Int?
  height        Int?
  /// contain | cover | fill
  fit           String       @default("contain")
  /// jpeg | png | webp | avif
  format        String       @default("jpeg")
  quality       Int          @default(85)
  stripMetadata Boolean      @default(true)
  position      Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([orgId, position])
  @@map("resize_preset")
}
